# Public Mapbox token (pk.*) from https://account.mapbox.com/access-tokens/
NEXT_PUBLIC_MAPBOX_TOKEN=pk.your_token_here

# Supabase Auth (public values: project URL and publishable key).
# Local: http://127.0.0.1:54321 and the publishable key printed by `supabase start`.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# Show phone (SMS code) sign-in. Needs an SMS provider in Supabase (local: a test code).
NEXT_PUBLIC_AUTH_PHONE=true

# ---- Server-only (API route handlers, scripts) ----
# Local Supabase; on Vercel use the Supabase pooler URL (port 6543).
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
# NIPOST Digital Postcode API (https://docs.postcode.gov.ng). Use a SECRET key
# (nipost_test_… for the sandbox, nipost_live_… for production), never a publishable one.
NIPOST_API_KEY=
NIPOST_API_URL=https://api.postcode.gov.ng
# Highest lookup level your key is granted: 1 = validity only … 5 = coordinates.
NIPOST_LOOKUP_LEVEL=1
# Mapbox token for server-side routing; defaults to NEXT_PUBLIC_MAPBOX_TOKEN if unset.
MAPBOX_TOKEN=
# Public URL of this site, used for absolute links in share previews.
SITE_URL=http://localhost:3000

# CAPTCHA on sign-in (Cloudflare Turnstile). Locally use Cloudflare's test site key
# (always passes); in production, your own site key, with the secret set in Supabase.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
