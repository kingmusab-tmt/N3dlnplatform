PORT=4000
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:54322/postgres
CORS_ORIGIN=http://localhost:3000

# NIPOST Digital Postcode API (https://docs.postcode.gov.ng). Use a SECRET key
# (nipost_test_… for the sandbox, nipost_live_… for production), never a publishable one.
NIPOST_API_KEY=
NIPOST_API_URL=https://api.postcode.gov.ng
# Highest lookup level your key is granted: 1 = validity only … 5 = coordinates.
NIPOST_LOOKUP_LEVEL=1

# Mapbox token for server-side routing (Directions API); the public pk.* token works.
MAPBOX_TOKEN=
